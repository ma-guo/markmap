<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/selector_point_item"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_m"
    android:paddingVertical="@dimen/space_s">

    <TextView
        android:id="@+id/tvPointDescription"
        style="@style/TextAppearance.MarkMap.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/ink"
        tools:text="Point Description" />

    <TextView
        android:id="@+id/tvStartTime"
        style="@style/TextAppearance.MarkMap.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:gravity="end"
        android:minWidth="40dp"
        android:textColor="@color/warning"
        tools:text="18:25" />

    <TextView
        android:id="@+id/tvDistance"
        style="@style/TextAppearance.MarkMap.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:gravity="end"
        android:minWidth="48dp"
        android:textColor="@color/primary"
        tools:text="1.2km" />

</LinearLayout>