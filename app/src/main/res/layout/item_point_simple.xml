<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/selector_point_item"
    android:foreground="?android:attr/selectableItemBackground"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="@dimen/space_m">

    <LinearLayout
        android:layout_width="18dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:minHeight="56dp"
        android:orientation="vertical"
        android:paddingTop="18dp">

        <View
            android:id="@+id/node"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_node_mid" />

        <View
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_marginTop="2dp"
            android:layout_weight="1"
            android:background="@color/divider" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:layout_weight="1"
        android:minHeight="56dp"
        android:orientation="vertical"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvPointDescription"
            style="@style/TextAppearance.MarkMap.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/ink"
            android:textStyle="bold"
            tools:text="红其拉甫口岸" />

        <TextView
            android:id="@+id/tvAdmin"
            style="@style/TextAppearance.MarkMap.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            tools:text="新疆维吾尔自治区 · 喀什地区 · 塔什库尔干塔吉克自治县" />

        <TextView
            android:id="@+id/tvStartTime"
            style="@style/TextAppearance.MarkMap.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            tools:text="05.12 08:30" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDistance"
        style="@style/TextAppearance.MarkMap.StatValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:minWidth="52dp"
        android:gravity="end"
        android:textColor="@color/ink_secondary"
        android:textSize="13sp"
        tools:text="0 km" />

</LinearLayout>
