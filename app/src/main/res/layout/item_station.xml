<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/screen_padding"
    android:paddingVertical="@dimen/space_m">

    <TextView
        android:id="@+id/tvStationName"
        style="@style/TextAppearance.MarkMap.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/ink"
        android:textStyle="bold"
        tools:text="广州南" />

    <TextView
        android:id="@+id/tvStationCode"
        style="@style/TextAppearance.MarkMap.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:textColor="@color/primary"
        tools:text="GZQ" />

    <TextView
        android:id="@+id/tvStationProvince"
        style="@style/TextAppearance.MarkMap.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        tools:text="广东" />

</LinearLayout>