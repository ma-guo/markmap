<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.MarkMap.Card"
    android:layout_width="168dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/radius_l">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_l">

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchShowMarkers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:minHeight="44dp"
            android:text="显示点图标"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_body_small" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchShowInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:checked="true"
            android:minHeight="44dp"
            android:text="显示点信息"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_body_small" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="@dimen/space_m"
            android:background="@color/divider" />

        <TextView
            style="@style/TextAppearance.MarkMap.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="连线颜色" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilColor"
            style="@style/Widget.MarkMap.TextInputLayout.Dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs">

            <AutoCompleteTextView
                android:id="@+id/actvColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:text="蓝色"
                android:textSize="@dimen/text_body_small" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>