<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_xxl">

    <TextView
        style="@style/TextAppearance.MarkMap.Headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="请输入列车车次"
        android:textColor="@color/ink" />

    <EditText
        android:id="@+id/etTrainCode"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="@dimen/space_l"
        android:background="@drawable/edit_text_bg"
        android:cursorVisible="false"
        android:focusable="false"
        android:gravity="center"
        android:hint="例如 G1936"
        android:paddingHorizontal="@dimen/space_m"
        android:textColor="@color/ink"
        android:textColorHint="@color/ink_tertiary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/dateContainer"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="@dimen/space_m"
        android:background="@drawable/edit_text_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_m">

        <TextView
            style="@style/TextAppearance.MarkMap.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="出行日期" />

        <TextView
            android:id="@+id/tvDateValue"
            style="@style/TextAppearance.MarkMap.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="@color/primary"
            android:textStyle="bold" />

    </LinearLayout>

    <GridLayout
        android:id="@+id/keyboardGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:columnCount="5"
        android:rowCount="4">

        <TextView
            android:id="@+id/keyG"
            style="@style/KeyButtonOrange"
            android:text="G"
            android:tag="G" />

        <TextView
            android:id="@+id/keyD"
            style="@style/KeyButtonOrange"
            android:text="D"
            android:tag="D" />

        <TextView
            android:id="@+id/key1"
            style="@style/KeyButtonBlack"
            android:text="1"
            android:tag="1" />

        <TextView
            android:id="@+id/key2"
            style="@style/KeyButtonBlack"
            android:text="2"
            android:tag="2" />

        <TextView
            android:id="@+id/key3"
            style="@style/KeyButtonBlack"
            android:text="3"
            android:tag="3" />

        <TextView
            android:id="@+id/keyC"
            style="@style/KeyButtonOrange"
            android:text="C"
            android:tag="C" />

        <TextView
            android:id="@+id/keyK"
            style="@style/KeyButtonOrange"
            android:text="K"
            android:tag="K" />

        <TextView
            android:id="@+id/key4"
            style="@style/KeyButtonBlack"
            android:text="4"
            android:tag="4" />

        <TextView
            android:id="@+id/key5"
            style="@style/KeyButtonBlack"
            android:text="5"
            android:tag="5" />

        <TextView
            android:id="@+id/key6"
            style="@style/KeyButtonBlack"
            android:text="6"
            android:tag="6" />

        <TextView
            android:id="@+id/keyL"
            style="@style/KeyButtonOrange"
            android:text="L"
            android:tag="L" />

        <TextView
            android:id="@+id/keyT"
            style="@style/KeyButtonOrange"
            android:text="T"
            android:tag="T" />

        <TextView
            android:id="@+id/key7"
            style="@style/KeyButtonBlack"
            android:text="7"
            android:tag="7" />

        <TextView
            android:id="@+id/key8"
            style="@style/KeyButtonBlack"
            android:text="8"
            android:tag="8" />

        <TextView
            android:id="@+id/key9"
            style="@style/KeyButtonBlack"
            android:text="9"
            android:tag="9" />

        <TextView
            android:id="@+id/keyZ"
            style="@style/KeyButtonOrange"
            android:text="Z"
            android:tag="Z" />

        <TextView
            android:id="@+id/keyY"
            style="@style/KeyButtonOrange"
            android:text="Y"
            android:tag="Y" />

        <TextView
            android:id="@+id/keyS"
            style="@style/KeyButtonOrange"
            android:text="S"
            android:tag="S" />

        <TextView
            android:id="@+id/key0"
            style="@style/KeyButtonBlack"
            android:text="0"
            android:tag="0" />

        <TextView
            android:id="@+id/keyX"
            style="@style/KeyButtonOrange"
            android:text="X"
            android:tag="X" />

    </GridLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancel"
            style="@style/TextAppearance.MarkMap.Body"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:text="取消"
            android:textColor="@color/ink_secondary" />

        <TextView
            android:id="@+id/btnConfirm"
            style="@style/TextAppearance.MarkMap.Body"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/space_m"
            android:layout_weight="1"
            android:background="@drawable/btn_confirm_bg"
            android:gravity="center"
            android:text="确认"
            android:textColor="@color/white"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>