<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============ 基础色板：黛青 + 米白 + 陶土 ============ -->
    <!-- 文字 -->
    <color name="ink">#FF1C2328</color>
    <color name="ink_secondary">#FF6E7780</color>
    <color name="ink_tertiary">#FF9EA6AD</color>

    <!-- 主色：黛青 -->
    <color name="primary">#FF1F5B63</color>
    <color name="primary_dark">#FF153F45</color>
    <color name="primary_container">#FFE4EFEF</color>

    <!-- 强调色：陶土 -->
    <color name="accent">#FFB5653C</color>
    <color name="accent_container">#FFF7ECE4</color>

    <!-- 背景与表面 -->
    <color name="background">#FFF6F5F1</color>
    <color name="surface">#FFFFFFFF</color>
    <color name="surface_alt">#FFFBFAF7</color>

    <!-- 描边与分割 -->
    <color name="outline">#FFE7E3DB</color>
    <color name="divider">#FFEDEAE3</color>

    <!-- 状态色 -->
    <color name="success">#FF2F7D5D</color>
    <color name="error">#FFB3453A</color>
    <color name="warning">#FFB07A2A</color>

    <!-- ============ 兼容旧资源名（避免遗漏引用） ============ -->
    <color name="black">@color/ink</color>
    <color name="white">#FFFFFFFF</color>
    <color name="teal_200">@color/primary</color>
    <color name="teal_700">@color/primary</color>
    <color name="purple_500">@color/primary</color>
    <color name="divider_color">@color/divider</color>
    <color name="gray">@color/ink_secondary</color>
    <color name="orange_key">@color/accent</color>
    <color name="blue_confirm">@color/primary</color>
</resources>